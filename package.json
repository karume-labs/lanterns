{
  "name": "lanterns",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "bun --filter @lanterns/client dev",
    "dev:server": "bun --filter @lanterns/server dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write .",
    "format:check": "bunx biome format .",
    "file-size": "bun tools/check-file-size.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run file-size",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "lefthook": "^2.1.3",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3"
  }
}
